<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="tutorial_demo_2.Pages.ChangePasswordPage"
    Title="Change Password"
    BackgroundColor="#F2F6FC">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#DCEEFF" Offset="0.0"/>
                <GradientStop Color="#F3F7FF" Offset="0.55"/>
                <GradientStop Color="#FFFFFF" Offset="1.0"/>
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollView>
            <!--<VerticalStackLayout
                Padding="20,25"
                Spacing="0"
                HorizontalOptions="Center"
                MaximumWidthRequest="520">-->

            <VerticalStackLayout
    Padding="8,12"
    Spacing="0"
    HorizontalOptions="Fill"
    VerticalOptions="Start">

                <!--<Border
                    BackgroundColor="White"
                    Stroke="#E3EAF4"
                    StrokeThickness="1"
                    Padding="22"
                    Margin="0,0,0,20">-->
                <Border
    BackgroundColor="White"
    Stroke="#E3EAF4"
    StrokeThickness="1"
    Padding="22,24"
    Margin="0,0,0,15"
    HorizontalOptions="Fill">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22"/>
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow
                            Brush="#243B5A"
                            Offset="0,5"
                            Radius="14"
                            Opacity="0.12"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="14">

                        <VerticalStackLayout
                            Spacing="7"
                            HorizontalOptions="Center"
                            Margin="0,0,0,8">

                            <Border
                                BackgroundColor="#E7F1FF"
                                WidthRequest="68"
                                HeightRequest="68"
                                HorizontalOptions="Center">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="20"/>
                                </Border.StrokeShape>

                                <Label
                                    Text="🔐"
                                    FontSize="32"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"/>
                            </Border>

                            <Label
                                Text="Change Password"
                                FontSize="23"
                                FontAttributes="Bold"
                                TextColor="#173B70"
                                HorizontalOptions="Center"/>

                            <Label
                                Text="Create a strong password for your account"
                                FontSize="12"
                                TextColor="#8492A6"
                                HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>

                        <!-- Current Password -->
                        <VerticalStackLayout Spacing="7">

                            <Label
                                Text="Current Password"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="#344B68"/>

                            <Border
                                BackgroundColor="#F5F8FD"
                                Stroke="#DCE5F0"
                                StrokeThickness="1"
                                Padding="10,0">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>

                                <Grid ColumnDefinitions="*,Auto">

                                    <Entry
                                        Grid.Column="0"
                                        Placeholder="Enter current password"
                                        Text="{Binding CurrentPassword, Mode=TwoWay}"
                                        IsPassword="{Binding IsCurrentPasswordHidden}"
                                        TextColor="#243B5A"
                                        PlaceholderColor="#9AA8BA"
                                        BackgroundColor="Transparent"
                                        FontSize="14"
                                        HeightRequest="50"
                                        VerticalOptions="Center"/>

                                    <Button
                                        Grid.Column="1"
                                        Text="{Binding CurrentPasswordIcon}"
                                        Command="{Binding ToggleCurrentPasswordCommand}"
                                        BackgroundColor="Transparent"
                                        TextColor="#2878D0"
                                        FontSize="20"
                                        Padding="8,0"
                                        WidthRequest="45"
                                        HeightRequest="45"
                                        VerticalOptions="Center"/>

                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <!-- New Password -->
                        <VerticalStackLayout Spacing="7">

                            <Label
                                Text="New Password"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="#344B68"/>

                            <Border
                                BackgroundColor="#F5F8FD"
                                Stroke="#DCE5F0"
                                StrokeThickness="1"
                                Padding="10,0">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>

                                <Grid ColumnDefinitions="*,Auto">

                                    <Entry
                                        Grid.Column="0"
                                        Placeholder="Enter new password"
                                        Text="{Binding NewPassword, Mode=TwoWay}"
                                        IsPassword="{Binding IsNewPasswordHidden}"
                                        TextColor="#243B5A"
                                        PlaceholderColor="#9AA8BA"
                                        BackgroundColor="Transparent"
                                        FontSize="14"
                                        HeightRequest="50"
                                        VerticalOptions="Center"/>

                                    <Button
                                        Grid.Column="1"
                                        Text="{Binding NewPasswordIcon}"
                                        Command="{Binding ToggleNewPasswordCommand}"
                                        BackgroundColor="Transparent"
                                        TextColor="#2878D0"
                                        FontSize="20"
                                        Padding="8,0"
                                        WidthRequest="45"
                                        HeightRequest="45"
                                        VerticalOptions="Center"/>

                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Confirm Password -->
                        <VerticalStackLayout Spacing="7">

                            <Label
                                Text="Confirm New Password"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="#344B68"/>

                            <Border
                                BackgroundColor="#F5F8FD"
                                Stroke="#DCE5F0"
                                StrokeThickness="1"
                                Padding="10,0">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>

                                <Grid ColumnDefinitions="*,Auto">

                                    <Entry
                                        Grid.Column="0"
                                        Placeholder="Confirm new password"
                                        Text="{Binding ConfirmPassword, Mode=TwoWay}"
                                        IsPassword="{Binding IsConfirmPasswordHidden}"
                                        TextColor="#243B5A"
                                        PlaceholderColor="#9AA8BA"
                                        BackgroundColor="Transparent"
                                        FontSize="14"
                                        HeightRequest="50"
                                        VerticalOptions="Center"/>

                                    <Button
                                        Grid.Column="1"
                                        Text="{Binding ConfirmPasswordIcon}"
                                        Command="{Binding ToggleConfirmPasswordCommand}"
                                        BackgroundColor="Transparent"
                                        TextColor="#2878D0"
                                        FontSize="20"
                                        Padding="8,0"
                                        WidthRequest="45"
                                        HeightRequest="45"
                                        VerticalOptions="Center"/>

                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Password Requirements -->
                        <Border
                            BackgroundColor="#EFF7FF"
                            Stroke="#D8E9FF"
                            StrokeThickness="1"
                            Padding="14">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="13"/>
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="8">

                                <Label
                                    Text="Password Requirements"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    TextColor="#1D5B9D"/>

                                <Label
                                    Text="✓  Minimum 8 characters"
                                    FontSize="12"
                                    TextColor="#526B86"/>

                                <Label
                                    Text="✓  At least one uppercase letter"
                                    FontSize="12"
                                    TextColor="#526B86"/>

                                <Label
                                    Text="✓  At least one number"
                                    FontSize="12"
                                    TextColor="#526B86"/>

                                <Label
                                    Text="✓  At least one special character"
                                    FontSize="12"
                                    TextColor="#526B86"/>

                            </VerticalStackLayout>
                        </Border>

                        <!-- Error Message -->
                        <Label
                            Text="{Binding ErrorMessage}"
                            TextColor="#D32F2F"
                            FontSize="12"
                            HorizontalTextAlignment="Center"
                            IsVisible="{Binding HasError}"/>

                        <!-- Buttons -->
                        <Grid
                            ColumnDefinitions="*,*"
                            ColumnSpacing="10"
                            Margin="0,3,0,0">

                            <Button
                                Grid.Column="0"
                                Text="Cancel"
                                Command="{Binding CancelCommand}"
                                BackgroundColor="#E8EDF4"
                                TextColor="#40536B"
                                FontAttributes="Bold"
                                FontSize="13"
                                CornerRadius="12"
                                HeightRequest="49"
                                IsEnabled="{Binding IsNotBusy}"/>

                            <Button
                                Grid.Column="1"
                                Text="Change Password"
                                Command="{Binding ChangePasswordCommand}"
                                BackgroundColor="#1678D3"
                                TextColor="White"
                                FontAttributes="Bold"
                                FontSize="12"
                                CornerRadius="12"
                                HeightRequest="49"
                                IsEnabled="{Binding IsNotBusy}"/>

                        </Grid>

                        <ActivityIndicator
                            IsVisible="{Binding IsBusy}"
                            IsRunning="{Binding IsBusy}"
                            Color="#1678D3"
                            HeightRequest="30"/>

                    </VerticalStackLayout>
                </Border>

                <Label
                    Text="Keep your password confidential and secure."
                    FontSize="11"
                    TextColor="#8492A6"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Margin="0,0,0,15"/>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>

    
