<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="tutorial_demo_2.Pages.LeavePage"
    Title="Leave Management"
    BackgroundColor="#F3F6FC">

    <ContentPage.Resources>

        <Style x:Key="SectionTitleStyle" TargetType="Label">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="#1E293B" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="#64748B" />
        </Style>

    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem
            Text="＋ New Request"
            Order="Primary"
            Priority="0"
            Command="{Binding ToggleFormCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*">

        <Border
            Grid.Row="0"
            Margin="14,12,14,6"
            Padding="16,14"
            BackgroundColor="#3157D5"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 16">

            <Grid ColumnDefinitions="*,Auto">

                <VerticalStackLayout Spacing="4">
                    <Label
                        Text="Leave Management"
                        FontSize="21"
                        FontAttributes="Bold"
                        TextColor="White" />

                    <Label
                        Text="Manage your leave applications"
                        FontSize="12"
                        TextColor="#DCE6FF" />
                </VerticalStackLayout>

                <Border
                    Grid.Column="1"
                    WidthRequest="44"
                    HeightRequest="44"
                    BackgroundColor="#FFFFFF"
                    Opacity="0.20"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    VerticalOptions="Center">

                    <Label
                        Text="📅"
                        FontSize="23"
                        HorizontalTextAlignment="Center"
                        VerticalTextAlignment="Center" />
                </Border>

            </Grid>
        </Border>

        <Grid Grid.Row="1">

            <ScrollView>
                <VerticalStackLayout
                    Padding="14,8,14,20"
                    Spacing="12">

                    <Border
                        IsVisible="{Binding IsFormVisible}"
                        BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeThickness="1"
                        Padding="15"
                        StrokeShape="RoundRectangle 15">

                        <VerticalStackLayout Spacing="11">

                            <Grid ColumnDefinitions="*,Auto">

                                <Label
                                    Text="New Leave Request"
                                    Style="{StaticResource SectionTitleStyle}"
                                    VerticalOptions="Center" />

                                <Button
                                    Grid.Column="1"
                                    Text="✕"
                                    WidthRequest="32"
                                    HeightRequest="32"
                                    Padding="0"
                                    CornerRadius="16"
                                    BackgroundColor="#F1F5F9"
                                    TextColor="#475569"
                                    Clicked="OnCancelClicked" />

                            </Grid>

                            <BoxView
                                HeightRequest="1"
                                Color="#E2E8F0" />

                            <Label
                                Text="Leave Type"
                                Style="{StaticResource FieldLabelStyle}" />

                            <Border
                                Stroke="#E2E8F0"
                                StrokeThickness="1"
                                BackgroundColor="#F8FAFC"
                                StrokeShape="RoundRectangle 10"
                                Padding="8,0">

                                <Picker
                                    x:Name="leaveTypePicker"
                                    Title="Select Leave Type"
                                    TextColor="#1E293B"
                                    TitleColor="#94A3B8" />
                            </Border>

                            <Grid
                                ColumnDefinitions="*,*"
                                ColumnSpacing="10">

                                <VerticalStackLayout
                                    Grid.Column="0"
                                    Spacing="5">

                                    <Label
                                        Text="From Date"
                                        Style="{StaticResource FieldLabelStyle}" />

                                    <Border
                                        Stroke="#E2E8F0"
                                        StrokeThickness="1"
                                        BackgroundColor="#F8FAFC"
                                        StrokeShape="RoundRectangle 10"
                                        Padding="5,0">

                                        <DatePicker
                                            x:Name="fromDatePicker"
                                            Format="dd MMM yyyy"
                                            TextColor="#1E293B"
                                            DateSelected="OnFromDateSelected" />
                                    </Border>

                                </VerticalStackLayout>

                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="5">

                                    <Label
                                        Text="To Date"
                                        Style="{StaticResource FieldLabelStyle}" />

                                    <Border
                                        Stroke="#E2E8F0"
                                        StrokeThickness="1"
                                        BackgroundColor="#F8FAFC"
                                        StrokeShape="RoundRectangle 10"
                                        Padding="5,0">

                                        <DatePicker
                                            x:Name="toDatePicker"
                                            Format="dd MMM yyyy"
                                            TextColor="#1E293B" />
                                    </Border>

                                </VerticalStackLayout>

                            </Grid>

                            <Label
                                Text="Reason"
                                Style="{StaticResource FieldLabelStyle}" />

                            <Border
                                Stroke="#E2E8F0"
                                StrokeThickness="1"
                                BackgroundColor="#F8FAFC"
                                StrokeShape="RoundRectangle 10"
                                Padding="8">

                                <Editor
                                    x:Name="reasonEditor"
                                    Placeholder="Enter reason for leave"
                                    PlaceholderColor="#94A3B8"
                                    TextColor="#1E293B"
                                    AutoSize="TextChanges"
                                    MinimumHeightRequest="75"
                                    MaximumHeightRequest="120" />
                            </Border>

                            <Button
                                Text="Submit Leave Request"
                                Command="{Binding SubmitCommand}"
                                BackgroundColor="#3157D5"
                                TextColor="White"
                                FontAttributes="Bold"
                                FontSize="14"
                                CornerRadius="11"
                                HeightRequest="46" />

                        </VerticalStackLayout>
                    </Border>

                    <Grid ColumnDefinitions="*,Auto">

                        <Label
                            Text="Recent Leave Requests"
                            Style="{StaticResource SectionTitleStyle}"
                            VerticalOptions="Center" />

                        <ActivityIndicator
                            Grid.Column="1"
                            IsRunning="{Binding IsLoading}"
                            IsVisible="{Binding IsLoading}"
                            Color="#3157D5"
                            WidthRequest="25"
                            HeightRequest="25" />

                    </Grid>

                    <VerticalStackLayout
                        BindableLayout.ItemsSource="{Binding Leaves}"
                        Spacing="8">

                        <BindableLayout.EmptyView>
                            <Border
                                BackgroundColor="White"
                                Stroke="#E2E8F0"
                                StrokeThickness="1"
                                Padding="20"
                                StrokeShape="RoundRectangle 13">

                                <VerticalStackLayout
                                    Spacing="7"
                                    HorizontalOptions="Center">

                                    <Label
                                        Text="📋"
                                        FontSize="30"
                                        HorizontalTextAlignment="Center" />

                                    <Label
                                        Text="No Leave Requests Found"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        TextColor="#475569"
                                        HorizontalTextAlignment="Center" />

                                    <Label
                                        Text="Your leave applications will appear here."
                                        FontSize="11"
                                        TextColor="#94A3B8"
                                        HorizontalTextAlignment="Center" />

                                </VerticalStackLayout>
                            </Border>
                        </BindableLayout.EmptyView>

                        <BindableLayout.ItemTemplate>
                            <DataTemplate>

                                <Border
                                    BackgroundColor="White"
                                    Stroke="#E2E8F0"
                                    StrokeThickness="1"
                                    Padding="10,9"
                                    StrokeShape="RoundRectangle 12">

                                    <VerticalStackLayout Spacing="6">

                                        <Grid ColumnDefinitions="*,Auto">

                                            <Label
                                                Text="{Binding LeaveTypeName}"
                                                FontSize="14"
                                                FontAttributes="Bold"
                                                TextColor="#1E293B"
                                                VerticalOptions="Center"
                                                LineBreakMode="TailTruncation" />

                                            <Border
                                                Grid.Column="1"
                                                Padding="8,3"
                                                BackgroundColor="#E0E7FF"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 8">

                                                <Label
                                                    Text="{Binding Status}"
                                                    FontSize="10"
                                                    FontAttributes="Bold"
                                                    TextColor="#3157D5" />
                                            </Border>

                                        </Grid>

                                        <Grid
                                            ColumnDefinitions="*,*"
                                            ColumnSpacing="8">

                                            <VerticalStackLayout
                                                Grid.Column="0"
                                                Spacing="2">

                                                <Label
                                                    Text="FROM"
                                                    FontSize="9"
                                                    FontAttributes="Bold"
                                                    TextColor="#94A3B8" />

                                                <Label
                                                    Text="{Binding StartDate, StringFormat='{0:dd MMM yyyy}'}"
                                                    FontSize="11"
                                                    TextColor="#334155" />

                                            </VerticalStackLayout>

                                            <VerticalStackLayout
                                                Grid.Column="1"
                                                Spacing="2">

                                                <Label
                                                    Text="TO"
                                                    FontSize="9"
                                                    FontAttributes="Bold"
                                                    TextColor="#94A3B8" />

                                                <Label
                                                    Text="{Binding EndDate, StringFormat='{0:dd MMM yyyy}'}"
                                                    FontSize="11"
                                                    TextColor="#334155" />

                                            </VerticalStackLayout>

                                        </Grid>

                                        <Label
                                            Text="{Binding Reason}"
                                            FontSize="11"
                                            TextColor="#64748B"
                                            MaxLines="2"
                                            LineBreakMode="TailTruncation" />

                                        <Grid
                                            ColumnDefinitions="*,Auto"
                                            ColumnSpacing="5">

                                            <Label
                                                Text="{Binding Remark, StringFormat='Remark: {0}'}"
                                                FontSize="10"
                                                TextColor="#94A3B8"
                                                VerticalOptions="Center"
                                                MaxLines="1"
                                                LineBreakMode="TailTruncation" />

                                            <Button
                                                Grid.Column="1"
                                                Text="Delete"
                                                HeightRequest="30"
                                                WidthRequest="75"
                                                Padding="5,0"
                                                CornerRadius="7"
                                                FontSize="10"
                                                BackgroundColor="#FEE2E2"
                                                TextColor="#DC2626"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCommand}"
                                                CommandParameter="{Binding LeaveRequestId}" />

                                        </Grid>

                                    </VerticalStackLayout>

                                </Border>

                            </DataTemplate>
                        </BindableLayout.ItemTemplate>

                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>

            <Grid
                IsVisible="{Binding IsLoading}"
                BackgroundColor="#20000000"
                InputTransparent="False">

                <ActivityIndicator
                    IsRunning="{Binding IsLoading}"
                    Color="#3157D5"
                    WidthRequest="45"
                    HeightRequest="45"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />

            </Grid>

        </Grid>

    </Grid>

</ContentPage>



<!--<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:system="clr-namespace:System;assembly=netstandard"
             xmlns:local="clr-namespace:tutorial_demo_2.Pages"             
             x:Class="tutorial_demo_2.Pages.LeavePage"
             Title="📅 Leaves">

    <ContentPage.Resources>
        <Style x:Key="StatusLabelStyle" TargetType="Label">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextColor" Value="White"/>
            <Setter Property="HorizontalOptions" Value="End"/>
            <Setter Property="VerticalOptions" Value="Center"/>
        </Style>
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="➕ New Request" Order="Primary" Priority="0" Command="{Binding ToggleFormCommand}" />
    </ContentPage.ToolbarItems>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="1">
            --><!-- Background Gradient --><!--
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#87CEEB" Offset="0.0"/>
                    --><!-- Light Sky Blue --><!--
                    <GradientStop Color="#ADD8E6" Offset="0.5"/>
                    --><!-- Light Blue --><!--
                    <GradientStop Color="#FFFFFF" Offset="1.0"/>
                    --><!-- White --><!--
                </LinearGradientBrush>
            </Grid.Background>

            <ScrollView>
                <VerticalStackLayout Padding="20" Spacing="20">

                    --><!-- New Leave Request --><!--
                    <Frame x:Name="leaveRequestForm"
                           BackgroundColor="White"
                           Opacity="0.95"
                           CornerRadius="15"
                           Padding="20"
                           HasShadow="True"
                           IsVisible="{Binding IsFormVisible}">
                        <VerticalStackLayout Spacing="15">
                            <Label Text="New Leave Request"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#333333"/>

                            --><!-- Leave Type --><!--
                            <VerticalStackLayout Spacing="5">
                                <Label Text="Leave Type"
                                       TextColor="#666666"
                                       FontSize="14"/>
                                <Picker x:Name="leaveTypePicker"
                                        Title="Select Leave Type"
                                        ItemsSource="{Binding LeaveTypes}"
                                        SelectedItem="{Binding SelectedLeaveType}"/>
                            </VerticalStackLayout>

                            --><!-- Date Selection --><!--
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                                --><!-- From Date --><!--
                                <VerticalStackLayout Grid.Column="0" Spacing="5">
                                    <Label Text="From Date"
                                           TextColor="#666666"
                                           FontSize="14"/>
                                    <DatePicker x:Name="fromDatePicker"
                                              MinimumDate="{Binding Source={x:Static system:DateTime.Today}}"
                                              Date="{Binding FromDate}"/>
                                </VerticalStackLayout>

                                --><!-- To Date --><!--
                                <VerticalStackLayout Grid.Column="1" Spacing="5">
                                    <Label Text="To Date"
                                           TextColor="#666666"
                                           FontSize="14"/>
                                    <DatePicker x:Name="toDatePicker"
                                              MinimumDate="{Binding Source={x:Static system:DateTime.Today}}"
                                              Date="{Binding ToDate}"/>
                                </VerticalStackLayout>
                            </Grid>

                            --><!-- Reason --><!--
                            <VerticalStackLayout Spacing="5">
                                <Label Text="Reason"
                                       TextColor="#666666"
                                       FontSize="14"/>
                                <Editor x:Name="reasonEditor"
                                        Text="{Binding Reason}"
                                        Placeholder="Enter reason for leave"
                                        HeightRequest="100"
                                        AutoSize="TextChanges"/>
                            </VerticalStackLayout>

                            --><!-- Submit Button --><!--
                            <Button Text="Submit Request"
                                    BackgroundColor="#87CEEB" 
                                TextColor="White"
                                    CornerRadius="25"
                                    HeightRequest="50"
                                    Margin="0,10,0,0"
                                    Command="{Binding SubmitCommand}"/>
                        </VerticalStackLayout>
                    </Frame>

                    --><!-- Recent Leave Requests --><!--
                    <Frame BackgroundColor="White"
                           Opacity="0.95"
                           CornerRadius="15"
                           Padding="20"
                           HasShadow="True">
                        <Grid>
                            <VerticalStackLayout Spacing="15">
                                <Label Text="Recent Requests"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="#333333"/>

                                <CollectionView x:Name="leavesList"
                                              EmptyView="No recent leave requests"
                                              ItemsSource="{Binding Leaves}">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Frame Margin="0,5"
                                                   Padding="15"
                                                   CornerRadius="10"
                                                   BorderColor="#EEEEEE">
                                                <Grid RowDefinitions="Auto,Auto"
                                                      ColumnDefinitions="*, Auto">
                                                    --><!-- Leave Type and Date --><!--
                                                    <VerticalStackLayout Grid.Row="0" Grid.Column="0">
                                                        <Label Text="{Binding LeaveTypeName}"
                                                               FontAttributes="Bold"
                                                               TextColor="#333333"/>
                                                        <Label>
                                                            <Label.Text>
                                                                <MultiBinding StringFormat="{}{0:d} - {1:d}">
                                                                    <Binding Path="StartDate"/>
                                                                    <Binding Path="EndDate"/>
                                                                </MultiBinding>
                                                            </Label.Text>
                                                        </Label>
                                                        <Label Text="{Binding Reason}"
                                                               TextColor="#666666"
                                                               FontSize="12"/>
                                                    </VerticalStackLayout>

                                                    --><!-- Status --><!--
                                                    <Frame Grid.Row="0" 
                                                           Grid.Column="1"
                                                           Padding="0"
                                                           CornerRadius="15"
                                                           HasShadow="False">
                                                        <Label Text="{Binding Status}"
                                                               Style="{StaticResource StatusLabelStyle}">
                                                            <Label.Triggers>
                                                                <DataTrigger TargetType="Label"
                                                                            Binding="{Binding Status}"
                                                                            Value="Pending">
                                                                    <Setter Property="BackgroundColor"
                                                                            Value="#FFA500"/>
                                                                    --><!-- Orange --><!--
                                                                </DataTrigger>
                                                                <DataTrigger TargetType="Label"
                                                                            Binding="{Binding Status}"
                                                                            Value="Approved">
                                                                    <Setter Property="BackgroundColor"
                                                                            Value="#4CAF50"/>
                                                                    --><!-- Green --><!--
                                                                </DataTrigger>
                                                                <DataTrigger TargetType="Label"
                                                                            Binding="{Binding Status}"
                                                                            Value="Rejected">
                                                                    <Setter Property="BackgroundColor"
                                                                            Value="#FF0000"/>
                                                                    --><!-- Red --><!--
                                                                </DataTrigger>
                                                            </Label.Triggers>
                                                        </Label>
                                                    </Frame>

                                                    --><!-- Delete Button --><!--
                                                    <Button Grid.Row="1" Grid.Column="1"
                                                            Text="Delete"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type local:LeavePage}}, Path=DeleteCommand}"
                                                            CommandParameter="{Binding LeaveRequestId}"
                                                            BackgroundColor="#FF4444" 
                                                        TextColor="White"
                                                            HeightRequest="40"
                                                            CornerRadius="5"
                                                            Margin="0,10,0,0"
                                                            IsVisible="{Binding Status}">
                                                        <Button.Triggers>
                                                            <DataTrigger TargetType="Button"
                                                                        Binding="{Binding Status}"
                                                                        Value="Approved">
                                                                <Setter Property="IsVisible" Value="False" />
                                                            </DataTrigger>
                                                        </Button.Triggers>
                                                    </Button>
                                                </Grid>
                                            </Frame>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>

                            --><!-- Loader Overlay --><!--
                            <Grid IsVisible="{Binding IsLoading}"
                                  BackgroundColor="#80FFFFFF">
                                <VerticalStackLayout HorizontalOptions="Center" 
                                                   VerticalOptions="Center">
                                    <ActivityIndicator IsRunning="{Binding IsLoading}"
                                                     Color="#87CEEB" 
                                        HeightRequest="50"
                                                     WidthRequest="50"/>
                                        <Label Text="Loading..."
                                           TextColor="#333333"
                                           HorizontalOptions="Center"
                                           Margin="0,10,0,0"/>
                                </VerticalStackLayout>
                            </Grid>
                        </Grid>
                    </Frame>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>-->