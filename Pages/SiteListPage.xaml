<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:tutorial_demo_2.ViewModels"
    xmlns:models="clr-namespace:tutorial_demo_2.Models"
    x:Class="tutorial_demo_2.Pages.SiteListPage"
    x:DataType="vm:SiteListViewModel"
    Title="Site Selection"
    BackgroundColor="#F4F7FC">

    <Grid RowDefinitions="Auto,Auto,Auto,*"
          Padding="14,10">

        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#EAF3FF" Offset="0"/>
                <GradientStop Color="#F5F8FF" Offset="0.6"/>
                <GradientStop Color="#FFFFFF" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <VerticalStackLayout
            Grid.Row="0"
            Spacing="3"
            Margin="0,3,0,12">

            <Label
                Text="Choose Your Site"
                FontSize="25"
                FontAttributes="Bold"
                TextColor="#173B70"/>

            <Label
                Text="Select the site where you want to continue"
                FontSize="12"
                TextColor="#718096"/>
        </VerticalStackLayout>

        <Border
            Grid.Row="1"
            BackgroundColor="White"
            Stroke="#E1E9F5"
            StrokeThickness="1"
            Padding="10,0"
            Margin="0,0,0,10">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12"/>
            </Border.StrokeShape>

            <Grid ColumnDefinitions="Auto,*"
                  ColumnSpacing="8">

                <Label
                    Text="⌕"
                    FontSize="25"
                    TextColor="#2878D0"
                    VerticalOptions="Center"/>

                <SearchBar
                    Grid.Column="1"
                    Placeholder="Search site..."
                    Text="{Binding SearchText, Mode=TwoWay}"
                    TextColor="#253858"
                    PlaceholderColor="#9AA8BA"
                    BackgroundColor="Transparent"
                    FontSize="13"
                    HeightRequest="42"
                    CancelButtonColor="#2878D0"/>
            </Grid>
        </Border>

        <Grid
            Grid.Row="2"
            ColumnDefinitions="*,Auto"
            Margin="2,0,2,7">

            <Label
                Text="{Binding FilteredSites.Count, StringFormat='Available Sites ({0})'}"
                FontSize="15"
                FontAttributes="Bold"
                TextColor="#243B5A"
                VerticalOptions="Center"/>

            <ActivityIndicator
                Grid.Column="1"
                IsVisible="{Binding IsLoading}"
                IsRunning="{Binding IsLoading}"
                Color="#2878D0"
                WidthRequest="23"
                HeightRequest="23"/>
        </Grid>

        <CollectionView
            Grid.Row="3"
            ItemsSource="{Binding FilteredSites}"
            SelectionMode="None"
            BackgroundColor="Transparent"
            VerticalScrollBarVisibility="Always"
            RemainingItemsThreshold="5"
            RemainingItemsThresholdReachedCommand="{Binding LoadMoreSitesCommand}"
            ItemSizingStrategy="MeasureAllItems">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout
                    Orientation="Vertical"
                    ItemSpacing="6"/>
            </CollectionView.ItemsLayout>

            <CollectionView.EmptyView>
                <VerticalStackLayout
                    Spacing="8"
                    Padding="20,45"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">

                    <Label
                        Text="⌕"
                        FontSize="42"
                        TextColor="#A5B4C8"
                        HorizontalOptions="Center"/>

                    <Label
                        Text="No sites found"
                        FontSize="17"
                        FontAttributes="Bold"
                        TextColor="#425570"
                        HorizontalOptions="Center"/>

                    <Label
                        Text="Try searching with another site name."
                        FontSize="12"
                        TextColor="#8795A8"
                        HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:SiteModel">

                    <Border
                        BackgroundColor="White"
                        Stroke="#E4EAF3"
                        StrokeThickness="1"
                        Padding="9,7"
                        Margin="1,1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>

                        <Grid
                            ColumnDefinitions="36,*,Auto"
                            ColumnSpacing="9"
                            HeightRequest="43">

                            <Border
                                Grid.Column="0"
                                BackgroundColor="#E8F1FF"
                                WidthRequest="34"
                                HeightRequest="34"
                                VerticalOptions="Center">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>

                                <Label
                                    Text="{Binding SerialNumber}"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    TextColor="#2878D0"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"/>
                            </Border>

                            <VerticalStackLayout
                                Grid.Column="1"
                                VerticalOptions="Center"
                                Spacing="1">

                                <Label
                                    Text="{Binding SiteName}"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    TextColor="#243B5A"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="1"/>

                                <Label
                                    Text="{Binding SiteLocation}"
                                    FontSize="10"
                                    TextColor="#8492A6"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="1"/>
                            </VerticalStackLayout>

                            <Button
                                Grid.Column="2"
                                Text="Select"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SiteListViewModel}}, Path=SelectSiteCommand}"
                                CommandParameter="{Binding .}"
                                BackgroundColor="#2878D0"
                                TextColor="White"
                                FontSize="11"
                                FontAttributes="Bold"
                                CornerRadius="8"
                                HeightRequest="33"
                                Padding="11,0"
                                VerticalOptions="Center"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>


