<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
        xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
        xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
        x:Class="tutorial_demo_2.Pages.ForgotPasswordPage"
         Title="ForgotPasswordPage"
         Shell.NavBarIsVisible="False"
         BackgroundColor="#F2F6FC">

        <Grid>
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#DCEEFF" Offset="0.0"/>
                    <GradientStop Color="#F3F7FF" Offset="0.6"/>
                    <GradientStop Color="#FFFFFF" Offset="1.0"/>
                </LinearGradientBrush>
            </Grid.Background>

            <ScrollView>
                <VerticalStackLayout
                Padding="15,30"
                Spacing="0"
                VerticalOptions="Center"
                HorizontalOptions="Fill">

                    <Border
                    BackgroundColor="White"
                    Stroke="#E3EAF4"
                    StrokeThickness="1"
                    Padding="22"
                    HorizontalOptions="Fill">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="24"/>
                        </Border.StrokeShape>

                        <Border.Shadow>
                            <Shadow
                            Brush="#243B5A"
                            Offset="0,5"
                            Radius="15"
                            Opacity="0.12"/>
                        </Border.Shadow>

                        <VerticalStackLayout Spacing="20">

                            <VerticalStackLayout
                            Spacing="10"
                            HorizontalOptions="Center">

                                <Border
                                BackgroundColor="#E7F1FF"
                                WidthRequest="85"
                                HeightRequest="85"
                                StrokeThickness="0">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="25"/>
                                    </Border.StrokeShape>

                                    <Label
                                    Text="🔐"
                                    FontSize="38"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"/>
                                </Border>

                                <Label
                                Text="Forgot Password?"
                                FontSize="25"
                                FontAttributes="Bold"
                                TextColor="#173B70"
                                HorizontalOptions="Center"/>

                                <Label
                                Text="Enter your Workman ID to request password recovery."
                                FontSize="13"
                                TextColor="#8492A6"
                                HorizontalTextAlignment="Center"
                                HorizontalOptions="Center"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="8">

                                <Label
                                Text="Workman ID"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="#344B68"/>

                                <Border
                                BackgroundColor="#F5F8FD"
                                Stroke="#DCE5F0"
                                StrokeThickness="1"
                                Padding="14,0"
                                HeightRequest="55">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12"/>
                                    </Border.StrokeShape>

                                    <Entry
                                    Text="{Binding WorkmanId}"
                                    Placeholder="Enter your Workman ID"
                                    FontSize="15"
                                    TextColor="#243B5A"
                                    PlaceholderColor="#9AA8BA"
                                    BackgroundColor="Transparent"
                                    VerticalOptions="Center"
                                    ReturnType="Done"/>
                                </Border>
                            </VerticalStackLayout>

                            <Label
                            Text="{Binding Message}"
                            TextColor="{Binding MessageColor}"
                            FontSize="13"
                            HorizontalTextAlignment="Center"
                            IsVisible="{Binding HasMessage}"/>

                            <Button
                            Text="Send Reset Request"
                            Command="{Binding ForgotPasswordCommand}"
                            BackgroundColor="#1678D3"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="15"
                            CornerRadius="13"
                            HeightRequest="52"
                            IsEnabled="{Binding IsNotBusy}"/>

                            <ActivityIndicator
                            IsVisible="{Binding IsBusy}"
                            IsRunning="{Binding IsBusy}"
                            Color="#1678D3"
                            HeightRequest="35"/>

                            <Button
                            Text="Back to Login"
                            Command="{Binding BackToLoginCommand}"
                            BackgroundColor="#E8F1FC"
                            TextColor="#1678D3"
                            FontAttributes="Bold"
                            FontSize="14"
                            CornerRadius="13"
                            HeightRequest="48"
                            IsEnabled="{Binding IsNotBusy}"/>

                        </VerticalStackLayout>
                    </Border>

                    <Label
                    Text="Keep your account secure."
                    FontSize="12"
                    TextColor="#8492A6"
                    HorizontalOptions="Center"
                    Margin="0,20,0,0"/>

                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </ContentPage>